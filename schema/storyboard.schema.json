{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeritageShortStoryboard",
  "type": "object",
  "required": [
    "title",
    "language",
    "aspect_ratios",
    "style_block",
    "character_reference",
    "music_cues",
    "shots"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "logline": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "target_duration_sec": {
      "type": "number",
      "minimum": 60,
      "maximum": 90
    },
    "aspect_ratios": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "16:9",
          "9:16"
        ]
      },
      "minItems": 1
    },
    "style_block": {
      "type": "string",
      "minLength": 5
    },
    "character_reference": {
      "type": "object",
      "required": [
        "name",
        "description",
        "seed"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "reference_image_path": {
          "type": "string"
        }
      }
    },
    "music_cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "cue_id",
          "start_sec",
          "end_sec",
          "caption",
          "tempo_bpm",
          "key",
          "seed"
        ],
        "properties": {
          "cue_id": {
            "type": "string"
          },
          "start_sec": {
            "type": "number",
            "minimum": 0
          },
          "end_sec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "caption": {
            "type": "string"
          },
          "tempo_bpm": {
            "type": "integer",
            "minimum": 40,
            "maximum": 200
          },
          "key": {
            "type": "string"
          },
          "seed": {
            "type": "integer"
          },
          "instrumental": {
            "type": "boolean"
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "duration_sec",
          "shot_type",
          "reason",
          "image_prompt",
          "motion_prompt",
          "narration_local",
          "narration_en",
          "seed"
        ],
        "properties": {
          "shot_id": {
            "type": "string"
          },
          "duration_sec": {
            "type": "number",
            "minimum": 3,
            "maximum": 12
          },
          "shot_type": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 5
          },
          "image_prompt": {
            "type": "string",
            "minLength": 5
          },
          "motion_prompt": {
            "type": "string",
            "minLength": 3
          },
          "narration_local": {
            "type": "string"
          },
          "narration_en": {
            "type": "string"
          },
          "seed": {
            "type": "integer"
          },
          "use_video": {
            "type": "boolean"
          }
        }
      }
    }
  }
}